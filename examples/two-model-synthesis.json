    "notes": [
      { "id": "note-models", "text": "Set both model IDs served by the same endpoint. Both see the same brief; their text outputs become literal values in the final synthesis prompt. Recent model IDs are available from each model field.", "color": "violet", "position": { "x": 1200, "y": 0 }, "width": 300, "height": 170 },
      { "id": "note-final-model", "text": "The final generation uses Model B as the editor. Swap that wire to Model A, or add a third model node, to change who performs the synthesis.", "color": "amber", "position": { "x": 0, "y": 650 }, "width": 250, "height": 170 }
    ]
  }
