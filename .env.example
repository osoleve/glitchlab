# Root used for saved graphs, caches, and file nodes. Relative paths resolve
# from the directory where Glitchlab starts.
GLITCHLAB_WORKSPACE=.

# Optional state-root override. The default is .glitchlab in the workspace.
GLITCHLAB_STATE_DIR=

# Optional cache override. The default is .glitchlab/cache in the workspace.
GLITCHLAB_CACHE_DIR=

# Keep disabled unless graphs intentionally need files outside the workspace.
GLITCHLAB_ALLOW_ABSOLUTE_PATHS=0

# Optional root of a compatible local Glitchlings checkout (the adapter adds /src).
GLITCHLAB_GLITCHLINGS_PATH=

# Optional server binding.
GLITCHLAB_HOST=127.0.0.1
GLITCHLAB_PORT=8788

# Provider keys are referenced by variable name from endpoint nodes.
OPENROUTER_API_KEY=

# Optional token for private Hugging Face dataset repositories.
HF_TOKEN=
