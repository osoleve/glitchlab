# Root used by Read File and Write File nodes.
GLITCHLOOM_WORKSPACE=C:\path\to\your\experiment

# Root of a local osoleve/glitchlings checkout (the adapter adds /src).
GLITCHLOOM_GLITCHLINGS_PATH=C:\path\to\glitchlings

# Optional server binding.
GLITCHLOOM_HOST=127.0.0.1
GLITCHLOOM_PORT=8788

# Provider keys are referenced by variable name from endpoint nodes.
OPENROUTER_API_KEY=

# Optional token for private Hugging Face dataset repositories.
HF_TOKEN=
