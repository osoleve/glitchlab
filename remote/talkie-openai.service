[Unit]
Description=Glitchloom OpenAI-compatible Talkie completion service
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mechinterp-play
EnvironmentFile=-%h/.config/glitchloom/talkie-openai.env
Environment=PYTHONUNBUFFERED=1
Environment=TALKIE_BIND_HOST=127.0.0.1
ExecStart=%h/mechinterp-play/.venv/bin/uvicorn glitchloom_talkie_api:app --host ${TALKIE_BIND_HOST} --port 8790
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=default.target
