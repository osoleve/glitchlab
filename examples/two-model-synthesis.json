    { "id": "brief-b", "source": "brief", "source_port": "text", "target": "completion-b", "target_port": "prompt" },
    { "id": "completion-a-extract", "source": "completion-a", "source_port": "result", "target": "extract-a", "target_port": "value" },
    { "id": "completion-b-extract", "source": "completion-b", "source_port": "result", "target": "extract-b", "target_port": "value" },
    { "id": "template-fill-a", "source": "synthesis-template", "source_port": "template", "target": "fill-a", "target_port": "template" },
    { "id": "extract-a-fill", "source": "extract-a", "source_port": "value", "target": "fill-a", "target_port": "value" },
    { "id": "fill-a-fill-b", "source": "fill-a", "source_port": "template", "target": "fill-b", "target_port": "template" },
    { "id": "extract-b-fill", "source": "extract-b", "source_port": "value", "target": "fill-b", "target_port": "value" },
    { "id": "fill-b-render", "source": "fill-b", "source_port": "template", "target": "render-synthesis", "target_port": "template" },
    { "id": "render-completion", "source": "render-synthesis", "source_port": "text", "target": "completion-synthesis", "target_port": "prompt" },
    { "id": "synthesis-extract", "source": "completion-synthesis", "source_port": "result", "target": "extract-synthesis", "target_port": "value" },
    { "id": "compare-a", "source": "extract-a", "source_port": "value", "target": "compare", "target_port": "series" },
    { "id": "compare-b", "source": "extract-b", "source_port": "value", "target": "compare", "target_port": "series" },
    { "id": "compare-synthesis", "source": "extract-synthesis", "source_port": "value", "target": "compare", "target_port": "series" }
  ],
  "presentation": {
    "edge_routing": "smoothstep",
    "frames": [
      { "id": "frame-resources", "title": "One endpoint · two models", "color": "slate", "position": { "x": -40, "y": -40 }, "width": 300, "height": 620, "collapsed": false, "node_ids": ["endpoint", "model-a", "model-b"] },
      { "id": "frame-candidates", "title": "Parallel candidates", "color": "violet", "position": { "x": 280, "y": -40 }, "width": 900, "height": 560, "collapsed": false, "node_ids": ["brief", "completion-a", "extract-a", "completion-b", "extract-b"] },
      { "id": "frame-synthesis-prompt", "title": "Bind both candidates into one prompt", "color": "teal", "position": { "x": 280, "y": 500 }, "width": 1160, "height": 300, "collapsed": false, "node_ids": ["synthesis-template", "fill-a", "fill-b", "render-synthesis"] },
      { "id": "frame-synthesis-output", "title": "One final synthesis generation", "color": "amber", "position": { "x": 840, "y": 780 }, "width": 880, "height": 340, "collapsed": false, "node_ids": ["completion-synthesis", "extract-synthesis", "compare"] }
    ],
    "wires": [],
