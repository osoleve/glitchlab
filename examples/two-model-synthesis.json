{
  "name": "Two-model synthesis",
  "nodes": [
    {
      "id": "endpoint",
      "kind": "endpoint",
      "title": "Shared completion API",
      "config": { "base_url": "http://127.0.0.1:8790/v1", "api_key_env": "", "timeout_seconds": 180 },
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "model-a",
      "kind": "model",
      "title": "Model A · divergent",
      "config": { "model_id": "first-model-id" },
      "position": { "x": 0, "y": 200 }
    },
    {
      "id": "model-b",
      "kind": "model",
      "title": "Model B · editor",
      "config": { "model_id": "second-model-id" },
      "position": { "x": 0, "y": 400 }
    },
    {
      "id": "brief",
      "kind": "text_input",
      "title": "Shared creative brief",
      "config": {
        "text": "Invent a compact premise for a science-fiction story about a city that can remember its residents. Favor one vivid mechanism, one human conflict, and one surprising consequence. Return only the premise."
      },
      "position": { "x": 320, "y": 0 }
    },
    {
      "id": "completion-a",
      "kind": "completion",
      "title": "Model A candidate",
      "config": { "temperature": 0.95, "top_p": 0.98, "max_tokens": 240, "seed": 301, "stop": "", "logprobs": null, "extra_body": {}, "cache_mode": "use" },
      "position": { "x": 600, "y": 0 }
    },
    {
      "id": "extract-a",
      "kind": "select_field",
      "title": "Take candidate A text",
      "config": { "path": "text" },
      "position": { "x": 900, "y": 0 }
    },
    {
      "id": "completion-b",
      "kind": "completion",
      "title": "Model B candidate",
      "config": { "temperature": 0.75, "top_p": 0.92, "max_tokens": 240, "seed": 302, "stop": "", "logprobs": null, "extra_body": {}, "cache_mode": "use" },
      "position": { "x": 600, "y": 260 }
    },
    {
      "id": "extract-b",
      "kind": "select_field",
      "title": "Take candidate B text",
      "config": { "path": "text" },
      "position": { "x": 900, "y": 260 }
    },
    {
      "id": "synthesis-template",
      "kind": "template_input",
      "title": "Synthesis prompt",
      "config": {
        "template": "Act as a demanding story editor. Synthesize the strongest compatible ideas from both candidate premises into one sharper premise. Do not simply concatenate them. Resolve contradictions, retain a concrete speculative mechanism, and foreground a human choice.\n\nCandidate A:\n?draft_a\n\nCandidate B:\n?draft_b\n\nReturn only the synthesis."
      },
      "position": { "x": 320, "y": 540 }
    },
    {
      "id": "fill-a",
      "kind": "fill_hole",
      "title": "Bind candidate A",
      "config": { "name": "draft_a", "value": "" },
      "position": { "x": 600, "y": 540 }
    },
    {
      "id": "fill-b",
      "kind": "fill_hole",
      "title": "Bind candidate B",
      "config": { "name": "draft_b", "value": "" },
      "position": { "x": 880, "y": 540 }
    },
    {
      "id": "render-synthesis",
      "kind": "render_template",
      "title": "Render synthesis prompt",
      "config": {},
      "position": { "x": 1160, "y": 540 }
    },
    {
      "id": "completion-synthesis",
      "kind": "completion",
      "title": "Model B synthesis",
      "config": { "temperature": 0.55, "top_p": 0.9, "max_tokens": 320, "seed": 303, "stop": "", "logprobs": null, "extra_body": {}, "cache_mode": "use" },
      "position": { "x": 880, "y": 820 }
    },
    {
      "id": "extract-synthesis",
      "kind": "select_field",
      "title": "Take synthesis text",
      "config": { "path": "text" },
      "position": { "x": 1160, "y": 820 }
    },
    {
      "id": "compare",
      "kind": "compare_preview",
      "title": "Candidates and synthesis",
      "config": {},
      "position": { "x": 1440, "y": 820 }
    }
  ],
  "edges": [
    { "id": "endpoint-a", "source": "endpoint", "source_port": "endpoint", "target": "completion-a", "target_port": "endpoint" },
    { "id": "endpoint-b", "source": "endpoint", "source_port": "endpoint", "target": "completion-b", "target_port": "endpoint" },
